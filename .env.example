# Copie como .env o ejecute ./iniciar.sh para generar secretos automáticamente.
# Formato KEY=valor sencillo o KEY='valor literal con espacios, $ o #'. Nunca ejecutar con source.
# Comillas simples sólo delimitan: no admita apóstrofes internos, controles ni barra inversa al final.
# ./configurar.sh --password-bd permite elegir DB_PASSWORD con entrada oculta y confirmación.
# Mínimo 12 caracteres; admite letras, números y . _ / : @ % + = , - !
# Esta opción sólo actualiza .env; una base existente requiere cambiar también su clave con \password.
COMPOSE_PROJECT_NAME=siabuc-helpdesk
# WEB_BIND_HOST controla SOLO Angular. 127.0.0.1 es local; IP LAN o 0.0.0.0 permiten otros equipos.
WEB_BIND_HOST=127.0.0.1
# BIND_HOST es compatibilidad con .env anteriores: solo se usa si WEB_BIND_HOST no existe.
BIND_HOST=127.0.0.1
# Puertos para desarrollo/solo-bd en 127.0.0.1; no se publican en modo Docker normal.
DB_PORT=5432
SERVER_PORT=8080
FRONTEND_PORT=4200
DB_NAME=siabuc_helpdesk
DB_USER=siabuc
DB_PASSWORD=CAMBIAR_PASSWORD_DB
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN
COOKIE_SECURE=false
# Zona horaria de fechas en reportes. El calendario de SLA se configura en la plataforma.
REPORTING_TIME_ZONE=America/Mexico_City
# Destino privado exclusivo para respaldos automáticos. El calendario inicia DESACTIVADO.
# Configúrelo luego en la plataforma: Respaldos (ADMIN). Rutas relativas a este proyecto.
# Windows: BACKUP_DIRECTORY='C:/SIABUC/copias automaticas'; Linux: '/srv/siabuc/copias'.
# iniciar.bat / iniciar.sh crean la carpeta si falta, sin cambiar permisos de carpetas existentes.
BACKUP_DIRECTORY=./backups/automatic
# UID/GID del proceso dentro de Docker; 0 permite escribir en la carpeta privada inicial.
# Para ejecución sin root, use el dueño de la carpeta y configure sus permisos previamente.
BACKUP_UID=0
BACKUP_GID=0
ADMIN_EMAIL=
# 1.8.2: Gmail directo desde Spring Boot; Postfix es opcional (perfil local-smtp).
# Por seguridad el correo inicia DESACTIVADO hasta configurar un usuario y secreto reales.
# Configure ./configurar.sh --correo o --gmail-directo de forma interactiva.
# .env antiguos con SMTP_HOST=smtp conservan Postfix y sus credenciales sin cambios.
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_SECURITY=STARTTLS
MAIL_FROM=
MAIL_FROM_NAME='Soporte SIABUC'
MAIL_REPLY_TO=
MAIL_POLL_MS=15000
MAIL_MAX_ATTEMPTS=5
# Opcional Postfix en perfil local-smtp. Sin puertos publicados en Docker normal.
SMTP_INTERNAL_PORT=2525
SMTP_HOSTNAME=mail.siabuc.internal
# IP del anfitrión en la red local; 127.0.0.1 permite comenzar en el mismo equipo.
# Ejemplo LAN: 192.168.1.50. El asistente sugiere la IP de su equipo al ejecutarse.
SMTP_LOCAL_IP=127.0.0.1
SMTP_NETWORK_SUBNET=172.30.55.0/24
# Relay vacío: entrega directa MX/25, sujeta a conectividad y políticas del destinatario.
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
SMTP_RELAY_SECURITY=STARTTLS
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=
# Perfil opcional mail-test: sólo sumidero local, sin entrega a Internet.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Gmail directo 1.8.2 — EJEMPLO SIN CREDENCIALES, no copiar como .env completo.
# Primero ejecute ./configurar.sh para generar .env privado (DB_PASSWORD/ADMIN_PASSWORD).
# Copie SOLO estos ajustes no secretos o use ./configurar.sh --gmail-directo
# para guardar SMTP_PASSWORD por entrada oculta. Nunca suba su .env a GitHub.
# Correo desactivado hasta usar el asistente:
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_SECURITY=STARTTLS
SMTP_USERNAME=usuario@ejemplo.com
SMTP_PASSWORD=
MAIL_FROM=usuario@ejemplo.com
MAIL_FROM_NAME='Soporte SIABUC'
# Postfix no se inicia mientras SMTP_HOST sea smtp.gmail.com.
# Si su instalacion necesita acceso LAN, configure WEB_BIND_HOST=IP_REAL
# en su .env privado. No publique PostgreSQL ni backend.
